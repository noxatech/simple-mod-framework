{
    "compilerOptions": {
        "outDir": "./compiled",
        "rootDir": "./src",
        "allowJs": false, 
        "target": "ES2019",
        "module": "CommonJS",
        "esModuleInterop": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strict": false,
        "sourceMap": false,
        "declaration": false,
        "skipLibCheck": true,
        "checkJs": false
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["node_modules"]
}
